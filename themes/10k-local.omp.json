{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    { "type": "prompt", "alignment": "left", "segments": [
      { "type": "os", "style": "diamond", "leading_diamond": "╭─", "background": "#d3d7cf", "foreground": "#000000", "template": " {{ .Icon }} " },
      { "type": "path", "style": "powerline", "powerline_symbol": "", "background": "#3465a4", "foreground": "#ffffff", "template": "  {{ .Path }} ", "options": { "style": "full" } },
      { "type": "git", "style": "powerline", "powerline_symbol": "", "background": "#4e9a06", "foreground": "#ffffff", "template": "  {{ .HEAD }}{{ if .Working.Changed }} ✎{{ end }}{{ if .Staging.Changed }} ●{{ end }} " }
    ]},
    { "type": "prompt", "alignment": "right", "segments": [
      { "type": "executiontime", "style": "powerline", "invert_powerline": true, "powerline_symbol": "", "background": "#c4a000", "foreground": "#000000", "template": " {{ .FormattedMs }} " },
      { "type": "status", "style": "powerline", "invert_powerline": true, "powerline_symbol": "", "background": "#444444", "foreground": "#ffffff", "template": " {{ if gt .Code 0 }}✘ {{ .Code }}{{ else }}✔{{ end }} ", "options": { "always_enabled": true } },
      { "type": "time", "style": "diamond", "invert_powerline": true, "background": "#d3d7cf", "foreground": "#000000", "template": " {{ .CurrentDate | date .Format }}  " }
    ]},
    { "type": "prompt", "alignment": "left", "newline": true, "segments": [
      { "type": "text", "style": "plain", "foreground": "#d3d7cf", "template": "╰─❯ " }
    ]}
  ]
}
